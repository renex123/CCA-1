# CampusOne Smart Campus Management Platform
# Environment Configuration Template

# Supabase PostgreSQL Configuration (Optional — runs in local reactive mode if omitted)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Optional: LLM API Key for Live CampusAI Model (Grounding fallback active by default)
VITE_GEMINI_API_KEY=your-gemini-api-key-here

# Application Configuration
VITE_APP_NAME="CampusOne"
VITE_APP_ENV="development"
